# HOMESERVER_TAILNET_IP: set in France docker compose .env (tsmonster 100.x, see `tailscale status` on France).
# Things over TS must use "http://tailscale:PORT" and the PORT added to the relay

hs.rowan.sh {
	@root path /
	redir @root /admin 308

	reverse_proxy http://tailscale:2300
}

headscale.rowan.sh {
	reverse_proxy http://headscale:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
	}
}

