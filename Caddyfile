rt.rowan.sh {
    handle /RPC2* {
        reverse_proxy http://rutorrent:8000 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        reverse_proxy http://rutorrent:8080 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {remote_host}
        }
    }
}

# tarpit.rowan.sh — public leaderboard of everything the tarpit has caught.
# A real vhost, so it is matched before the catch-alls below and gets its own ACME
# certificate; *.rowan.sh is a wildcard A record to this host, so HTTP-01 validates.
#
# This is deliberately public. To restrict it later, either add basic_auth here, or
# a `@allowed remote_ip 100.64.0.0/10` matcher to limit it to the tailnet.
tarpit.rowan.sh {
	reverse_proxy http://tarpit-stats:8082
}

# HTTPS catch-all: same tarpit, for scanners that come in on :443.
#
# To tarpit an unknown hostname we have to COMPLETE a TLS handshake for it, which needs
# a certificate. `tls internal { on_demand }` mints one per SNI from Caddy's own local
# CA, on demand. Deliberately the internal CA and not ACME: issuing public certs for
# names we do not own would fail validation anyway, and letting strangers drive
# Let's Encrypt issuance is a fast route to a rate-limit ban. Internal issuance is
# local, ~12ms, and never touches the network.
#
# The cert is untrusted, which does not matter: scanners skip verification, and a real
# visitor who lands here was going somewhere that does not exist anyway.
#
# No default_sni needed — verified on 2.11.4 that a bare-IP connection with no SNI
# falls back to the connection's own address as the server name and is issued for that.
#
# This does NOT affect the named vhosts: they keep their own ACME certificates. Caddy
# builds a separate automation policy per subject, and matches named hosts before this
# block (confirmed with `caddy adapt`).
#
# Watch caddy's memory: every distinct SNI caches a cert, and the interval/burst limits
# that used to bound this were removed in Caddy 2.11.
:443 {
	log {
		output file /var/log/caddy/tarpit.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 2160h
			mode 644
		}
		format json
	}

	tls internal {
		on_demand
	}

	reverse_proxy http://tarpit:8081 {
		# Without this Caddy buffers the upstream body and the client sees nothing —
		# which is the silence problem the sidecar rewrite exists to fix. -1 flushes
		# every chunk straight through as it arrives.
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 300s
		}
	}
}

# Catch-all: anything that does not match a vhost above — bare-IP probes, random
# Host headers, vulnerability scanners. Previously answered a clean 404, which tells
# a scanner the box is alive and lets it move on in milliseconds. Now it goes to the
# tarpit sidecar (see server-compose.yaml), which never sends the blank line that ends
# its header block, so the connection hangs instead of moving on.
#
# The sidecar sends a COMPLETE header block up front, then dribbles chunked body
# forever. That ordering is deliberate. An earlier version never finished its headers,
# so reverse_proxy buffered everything and the client received zero bytes — measured
# 0 bytes in 40s — and scanners hang up quickly on silence. Answering 200 and then
# streaming slowly makes the host look alive, so they stay. flush_interval -1 below is
# required for this; without it Caddy buffers the body and the silence comes back.
#
# Caddy has no delay/tarpit module (verified against 2.11.4 with `caddy list-modules`),
# which is why this is a sidecar rather than a directive.
#
# response_header_timeout is what bounds OUR side: the upstream deliberately never
# completes its headers, so without it Caddy would hold the connection indefinitely.
# A tarpit costs the host a held connection per scanner, so it is capped at both ends
# — here, and by max-children on the socat listener.
#
# This is :80 only. Unmatched hostnames on :443 never get a certificate (on-demand TLS
# is off), so they already fail at the TLS handshake and never reach a handler.
:80 {
	# Access log for tarpitted traffic: who probed, from where, for what, and how long
	# they stayed. This has to live here rather than in the sidecar — Caddy terminates
	# the client connection, so the tarpit container only ever sees Caddy's bridge IP.
	#
	# Caddy writes the entry when the request FINISHES, so `duration` is the real time
	# the scanner spent held, and `status` is typically 502 (upstream never answered)
	# or an aborted-connection code when they gave up first.
	#
	# Rotated by Caddy itself: 10MiB per file, 5 kept, 90 days. A public IP attracts
	# constant background scanning, and every hit lands here, so this is deliberately
	# bounded — unrotated it would fill the disk.
	log {
		output file /var/log/caddy/tarpit.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 2160h
			# Caddy runs as root in this image, so the log defaults to 0600 and `rowan`
			# cannot read it without sudo. Rotation recreates the file, so the mode has to
			# be set here rather than chmod'd once.
			mode 644
		}
		format json
	}

	reverse_proxy http://tarpit:8081 {
		# Without this Caddy buffers the upstream body and the client sees nothing —
		# which is the silence problem the sidecar rewrite exists to fix. -1 flushes
		# every chunk straight through as it arrives.
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 300s
		}
	}
}
