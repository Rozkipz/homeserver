rt.rowan.sh {
    handle /RPC2* {
        reverse_proxy http://rutorrent:8000 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        reverse_proxy http://rutorrent:8080 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {remote_host}
        }
    }
}

:80 {
	respond "Not found" 404
}
